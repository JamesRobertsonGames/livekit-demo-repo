# Copy to .env.local and fill in. Never commit .env.local.
# `lk app env -w` writes these three for you from your LiveKit Cloud project.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Models are LiveKit Inference ids, so no other provider keys are needed.
# SHIPCHECK_STT_MODEL=assemblyai/universal-3-6-pro
# SHIPCHECK_LLM_MODEL=google/gemma-4-31b-it
# SHIPCHECK_TTS_MODEL=fishaudio/s2.1-pro
# SHIPCHECK_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# Measurement
SHIPCHECK_PROFILE=baseline
SHIPCHECK_PROMETHEUS_PORT=9465
# SHIPCHECK_TURNS_DIR=data/turns
# SHIPCHECK_LOG_TEXT=1   # include transcripts in the per-turn JSONL

# Stretch: warm transfer
# SHIPCHECK_TRANSFER_TO=+44...
# SHIPCHECK_SIP_OUTBOUND_TRUNK_ID=ST_...
